# Maintainer: qaqland <qaq@qaq.land>
pkgname=codebrowser
pkgver=2.1_git20260406
_gitrev=ebe91a86e4d06a23f5f7709d081f83e2cc14ef26
pkgrel=0
pkgdesc="Woboq CodeBrowser, Browsing C++ Source Code on the Web"
url="https://woboq.com/codebrowser.html"
arch="all"
license="CC-BY-NC-SA-3.0"
makedepends="
	clang22-dev
	clang22-extra-tools
	clang22-static
	cmake
	llvm22-dev
	llvm22-gtest
	llvm22-static
	samurai
	"
subpackages="$pkgname-doc"
source="$pkgname-$_gitrev.zip::https://github.com/KDAB/codebrowser/archive/$_gitrev.zip"
builddir="$srcdir/$pkgname-$_gitrev"
options="!check" # upstream has no testsuit

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr

	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	install -Dm644 README.md -t "$pkgdir"/usr/share/doc/$pkgname
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}

sha512sums="
7a633986bcca0a2de9ec0732d1dae5b716cf1f40382bfb2401fc6f15f955bffecb2507107d58e32809c1203bd521708912ce4db26155c8999562e64d5caea1d2  codebrowser-ebe91a86e4d06a23f5f7709d081f83e2cc14ef26.zip
"
